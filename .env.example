# InterviewOS environment — copy to .env at the repo root, never commit it.
# ---------------------------------------------------------------------------
# LLM (both free tiers, no card). Primary first, fallback second.
GEMINI_API_KEY=
GROQ_API_KEY=
# Order is by measurement, not by preference: on 2026-11-01 gemini-3.8-flash
# read-timed-out at 45 s twice while groq answered in 2.7 s. Flip these if that
# reverses; the gateway records both reasons either way.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
# Leave these as "auto": the app asks the provider which models the key can call
# and picks a stable Flash / a large open-weight model. Model names expire
# ("no longer available to new users"), hard-coding them is how this breaks.
# Pin one only when you want determinism — check GET /dev/llm/models for the list.
GEMINI_MODEL=auto
GROQ_MODEL=auto
LLM_TIMEOUT_S=25
GEMINI_THINKING=auto            # off = thinkingBudget 0, for when Gemini is slow

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # backend only, never in the frontend
STORAGE_BUCKET=resumes

# Postgres: runtime uses the transaction pooler (6543),
# migrations/checkpointer use session mode (5432) on the same pooler host.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Which profile owns the data until real auth lands. Leave empty when the project
# has exactly one user (the API says `user_source: single_profile` in the response).
# Otherwise: Supabase → Authentication → Users → Add user (auto-confirm), copy the id.
DEMO_USER_ID=

# Search backend for the learning-resource resolver
# ddgs = DuckDuckGo library (dev, no key) | searxng = self-hosted (prod)
SEARCH_BACKEND=ddgs
SEARXNG_URL=http://localhost:8080
YOUTUBE_API_KEY=                 # optional, ~100 searches/day
GITHUB_TOKEN=                    # optional, raises GitHub API to 5,000 req/hr

# Embeddings run locally: fastembed + bge-small-en-v1.5 (no key, no quota)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# App
ENV=dev
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
